{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker: serves the Vite build output from dist/.
  // "name" must match the project name in the Cloudflare dashboard.
  "name": "the-plot-tickens",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
